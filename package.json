{
  "name": "bangdream-na",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "worker:dev": "npm --prefix worker run dev",
    "worker:build": "npm --prefix worker run build",
    "worker:test": "npm --prefix worker test",
    "worker:test:coverage": "npm --prefix worker run test:coverage",
    "worker:typecheck": "npm --prefix worker run typecheck",
    "d1:migrate:local": "npm --prefix worker run d1:migrate:local",
    "d1:migrate:prod": "npm --prefix worker run d1:migrate:prod",
    "migrate:categories": "node scripts/migrate/categories-to-d1.mjs --remote",
    "migrate:news": "node scripts/migrate/news-to-d1.mjs --remote",
    "migrate:events": "node scripts/migrate/events-to-d1.mjs --remote",
    "migrate:members": "node scripts/migrate/members-to-d1.mjs --remote",
    "migrate:all": "npm run migrate:categories && npm run migrate:news && npm run migrate:events && npm run migrate:members",
    "migrate:dry-run": "node scripts/migrate/categories-to-d1.mjs --dry-run && node scripts/migrate/news-to-d1.mjs --dry-run && node scripts/migrate/events-to-d1.mjs --dry-run && node scripts/migrate/members-to-d1.mjs --dry-run"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "yet-another-react-lightbox": "^3.32.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^25.0.1",
    "vite": "^8.0.1",
    "vitest": "^3.2.4"
  }
}
