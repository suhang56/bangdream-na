# bangdream-na frontend env vars (vite reads at build time)
#
# VITE_API_BASE - the Cloudflare Worker API origin. Set to:
#   - https://api.bangdream.org   for production / Cloudflare Pages deployments
#   - http://localhost:8787       for local Worker dev (`npm run worker:dev`)
#
# When unset, the frontend falls back to https://api.bangdream.org. Production
# deployments should set this explicitly via Cloudflare Pages
# Settings → Environment variables → Production.
VITE_API_BASE=https://api.bangdream.org
